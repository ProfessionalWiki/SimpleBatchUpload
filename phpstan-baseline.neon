parameters:
	ignoreErrors:
		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\ParameterProvider\:\:addTemplateParameter\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/ParameterProvider.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\ParameterProvider\:\:populateParameters\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/ParameterProvider.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\ParameterProvider\:\:populateParametersFromDefaults\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/ParameterProvider.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\ParameterProvider\:\:populateParametersFromKey\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/ParameterProvider.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\ParameterProvider\:\:setParameters\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/ParameterProvider.php

		-
			message: '#^Property MediaWiki\\Extension\\SimpleBatchUpload\\ParameterProvider\:\:\$parameters has no type specified\.$#'
			identifier: missingType.property
			count: 1
			path: src/ParameterProvider.php

		-
			message: '#^Property MediaWiki\\Extension\\SimpleBatchUpload\\ParameterProvider\:\:\$templateName has no type specified\.$#'
			identifier: missingType.property
			count: 1
			path: src/ParameterProvider.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\SimpleBatchUpload\:\:onMakeGlobalVariablesScript\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/SimpleBatchUpload.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\SimpleBatchUpload\:\:onMakeGlobalVariablesScript\(\) has parameter \$vars with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/SimpleBatchUpload.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\SpecialBatchUpload\:\:addPageContentToOutput\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/SpecialBatchUpload.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\SpecialBatchUpload\:\:execute\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/SpecialBatchUpload.php

		-
			message: '#^Parameter \#2 \$templateName of method MediaWiki\\Extension\\SimpleBatchUpload\\UploadButtonRenderer\:\:renderSpecialPage\(\) expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/SpecialBatchUpload.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\UploadButtonRenderer\:\:addModulesToOutput\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/UploadButtonRenderer.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\UploadButtonRenderer\:\:renderParserFunction\(\) has parameter \$args with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/UploadButtonRenderer.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\UploadButtonRenderer\:\:renderParserFunction\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/UploadButtonRenderer.php

		-
			message: '#^Method MediaWiki\\Extension\\SimpleBatchUpload\\UploadButtonRenderer\:\:renderSpecialPage\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/UploadButtonRenderer.php
